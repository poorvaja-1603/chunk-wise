# Copy these settings into your shell before starting ChunkWise.
# This file is a template; ChunkWise does not automatically load .env files.

# Storage Backend: 'local' (SQLite + local chunk store) or 'aws' (DynamoDB + S3)
CHUNKWISE_BACKEND=local

# Local storage directory
CHUNKWISE_HOME=./.chunkwise

# Active compression profile: balanced | space_saver | fast_restore | disabled
CHUNKWISE_COMPRESSION_PROFILE=balanced

# HTTP Server Configuration
CHUNKWISE_HOST=127.0.0.1
PORT=8080
CHUNKWISE_MAX_UPLOAD_BYTES=104857600
CHUNKWISE_UPLOAD_CONCURRENCY=8

# AWS Cloud Configuration (Used when CHUNKWISE_BACKEND=aws)
AWS_PROFILE=pooh-dev
CHUNKWISE_AWS_REGION=ap-southeast-2
CHUNKWISE_S3_BUCKET=replace-with-your-existing-bucket
CHUNKWISE_DYNAMODB_TABLE=chunkwise-index
CHUNKWISE_CLOUDWATCH=0
