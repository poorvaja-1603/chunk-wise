# Copy these settings into your shell before starting ChunkWise.
# This file is a template; ChunkWise does not automatically load .env files.
CHUNKWISE_BACKEND=aws
CHUNKWISE_HOME=./.chunkwise
CHUNKWISE_S3_BUCKET=replace-with-your-existing-bucket
CHUNKWISE_DYNAMODB_TABLE=chunkwise-index
CHUNKWISE_AWS_REGION=us-east-1

# Keep the unauthenticated dashboard local unless protected by a proxy.
CHUNKWISE_HOST=127.0.0.1
PORT=8080
CHUNKWISE_MAX_UPLOAD_BYTES=104857600
